# Neon PostgreSQL connection string
# Example: postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional: SMTP email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Network Monitor <your-email@gmail.com>
ALERT_EMAIL_TO=your-email@gmail.com
EMAIL_ALERTS_ENABLED=true

# API URL used by the Streamlit dashboard
API_BASE_URL=http://127.0.0.1:8000

# Traffic capture agent (continuous monitoring)
AGENT_MODE=sample
AGENT_INTERVAL_SECONDS=5
AGENT_BATCH_SIZE=5
AGENT_INTERFACE=eth0
AGENT_RETRY_SECONDS=10
AGENT_SUBNET_PREFIX=192.168.1.
AGENT_AUTO_DETECT=true

# Automatic anomaly detection
DETECTION_AUTO_ENABLED=true
DETECTION_INTERVAL_SECONDS=30
DETECTION_WINDOW_MINUTES=5
AGENT_API_KEY=change-this-agent-key
